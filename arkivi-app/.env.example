# ==============================================================================
# KONFIGURIMI I PRODHIMIT (PRODUCTION ENVIRONMENT VARIABLES)
# Arkivi Përkujtimor Dritan Berisha
#
# Udhëzim: Kopjoni këtë skedar te `.env` në serverin tuaj të prodhimit:
#   cp .env.example .env
# dhe vendosni sekretet tuaja përkatëse.
# ==============================================================================

# Mjedisi i ekzekutimit
NODE_ENV=production
PORT=3001

# URL Publike e Serverit
# Në prodhim vendosni domenin tuaj të plotë me HTTPS (p.sh. https://arkivi.al ose https://arkivi.juaj.com)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Çelësi Sekret i Payload CMS (Gjeneroni një varg të rastësishëm me të paktën 32 karaktere)
# Mund të përdorni: openssl rand -hex 32
PAYLOAD_SECRET=ndrysho-kete-me-nje-sekret-shume-te-sigurt-prodhimi-2026-autorit

# Çelësi Sekret Administrativ (Përdoret për mbrojtjen e API-ve të ndjeshme dhe rivendosjes)
ADMIN_SECRET=sekret-sigurie-per-admin-dhe-reset-api-2026

# Rruga e Bazës së të Dhënave SQLite (Ruhet brenda volumit /app/data)
DATABASE_URI=file:./data/arkivi.db

# ==============================================================================
# LLOGARIA E ADMINISTRATORIT TEKNIK FILLITAR (SUPERUSER)
# Këto kredenciale krijohen automatikisht në nisjen e parë të kontejnerit:
# Paneli teknik: /admin
# Studio e autorit: /studio
# ==============================================================================
INITIAL_ADMIN_EMAIL=admin@arkivi.local
INITIAL_ADMIN_PASSWORD=Arkivi2026!
INITIAL_ADMIN_NAME=Administrator Teknik
